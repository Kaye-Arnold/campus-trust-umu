rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — owner write, authenticated read
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId;
      allow delete: if false;
    }

    // Provider records are curated server-side. Never trust a client to write
    // rating aggregates: those values are a community trust signal.
    match /providers/{providerId} {
      allow read: if true;
      allow write: if false;
    }

    // Reviews — public read; authenticated create only; immutable after submit
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.providerId is string
        && request.resource.data.ratingValue is int
        && request.resource.data.ratingValue >= 1
        && request.resource.data.ratingValue <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000;
      allow update, delete: if false;
    }
  }
}
